    {"key": "terms", "name": "Negotiate lease terms", "level": 2, "days": 10, "pred": ["tour"], "owner": "Finance lead", "optimistic": 5, "pessimistic": 20, "notes": "Estimate. Two rounds of comments assumed."},
    {"key": "legal", "name": "Landlord and legal review", "level": 2, "days": 14, "elapsed": true, "pred": ["terms"], "owner": "Landlord", "notes": "Calendar days. Landlord quoted two weeks."},
